# OpenClip environment — copy to .env and adjust

# App
PROJECT_NAME=OpenClip
APP_ENV=development
DEBUG=true
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Database
DATABASE_URL=postgresql+psycopg://openclip:openclip@localhost:5432/openclip

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Storage
STORAGE_ROOT=./storage

# Local LLM (Ollama) — no paid APIs required
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=qwen3:4b

# ASR
WHISPER_MODEL=large-v3

# Optional: required only for pyannote Community-1 download/use
HF_TOKEN=

# Hardware
GPU_ENABLED=true
MAX_CONCURRENT_GPU_JOBS=1
MAX_UPLOAD_SIZE=2147483648

# Tools
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# Config file (YAML overrides)
CONFIG_PATH=./config.yaml
